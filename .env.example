# PostgreSQL connection used by the NestJS API
DATABASE_URL=postgresql://localhost/insurance_workbench
API_PORT=3001
# Optional extra localhost Vite port for an isolated development preview.
# WORKBENCH_LOCAL_FRONTEND_PORT=5190

# Runware key for GPT Image image generation.
RUNWARE_API_KEY=
RUNWARE_IMAGE_MODEL=openai:gpt-image@2.5-flare

# DeepSeek OpenAI-compatible API for product extraction and all content-workspace text generation, planning, and polishing.
# Create an API key in the DeepSeek platform account and keep its value in the local .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash

# Local runner for the installed humanizer-zh and Baoyu skills. dev:stack starts it automatically.
SKILL_RUNNER_URL=http://127.0.0.1:3020
SKILL_RUNNER_HOST=127.0.0.1
SKILL_RUNNER_PORT=3020
SKILL_RUNNER_TOKEN=
SKILL_HUMANIZER_TIMEOUT_MS=180000
SKILL_IMAGE_REQUEST_TIMEOUT_MS=1800000

# Runware image generation concurrency (not total image count) and timeout.
BAOYU_IMAGE_BATCH_SIZE=2
BAOYU_IMAGE_BATCH_TIMEOUT_MS=1800000

# Optional PostgreSQL TLS and pool settings
PG_SSL=false
PG_POOL_MAX=10
# Optional outbound proxy for Node 24.5+ fetch calls. Uncomment and adjust if needed.
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
